# ---- Going live (see DEPLOY.md) ----
# Your domain, without https://. Used by the HTTPS proxy (Caddy) in docker-compose.yml
DOMAIN=
# Copy to .env and fill in, then: npm start

PORT=3000

# Owner account, created on first start. Sign in with this email (or phone) and password.
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com
OWNER_PHONE=9000000000
OWNER_PASSWORD=change-this-to-a-long-password

# Claude API key for the Saarathi agent (https://console.anthropic.com).
# Without it the agent shows as offline and customers use the booking form.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_QUICK_MODEL=claude-haiku-5-5

# Razorpay payment gateway (https://dashboard.razorpay.com → Account & Settings → API Keys).
# Use test keys (rzp_test_...) first; switch to live keys (rzp_live_...) after Razorpay activates your account.
# Leave blank to keep only manual UPI/bank payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhooks → Add webhook: URL https://YOUR-DOMAIN/api/pay/webhook, events payment.captured + order.paid + payment.failed,
# and a secret of at least 32 random characters, pasted here:
RAZORPAY_WEBHOOK_SECRET=

# ---- Flights & hotels (leave blank to hide the section) ----
# Flights: Duffel. Sign up at duffel.com → Developers → Access tokens → create a TEST token (starts duffel_test_).
# Test mode books "Duffel Airways" sandbox flights only. Live tickets need a live token and Duffel balance/top-up.
DUFFEL_ACCESS_TOKEN=
# Hotels: liteAPI. Sign up at liteapi.travel → dashboard → API keys → copy the SANDBOX key (starts sand_).
LITEAPI_KEY=
# How liteAPI is paid for each booking you make on the customer's behalf (default ACC_CREDIT_CARD = your liteAPI account card).
LITEAPI_PAYMENT_METHOD=ACC_CREDIT_CARD

# ---- Notifications (each channel switches on when its keys are filled) ----
# Website address used in email buttons, e.g. https://sashwanthtravels.in
PUBLIC_URL=
# Gmail: turn on 2-Step Verification, then myaccount.google.com/apppasswords → create an app password (16 letters).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourbusiness@gmail.com
SMTP_PASS=
MAIL_FROM=
# WhatsApp Cloud API (Meta): developers.facebook.com → your app → WhatsApp → API Setup.
# Create and get approved a UTILITY template named booking_update with body:  Sashwanth Travels update: {{1}}
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=booking_update
WHATSAPP_LANG=en
# SMS (India, DLT): MSG91 → Flow with a DLT-approved template using ##var1## (status) and ##var2## (booking ref).
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
# Where the owner receives alerts (defaults: owner account email, business WhatsApp number)
OWNER_NOTIFY_EMAIL=
OWNER_NOTIFY_PHONE=

# ---- Maps, location and weather (free, no keys) ----
# OpenStreetMap maps, OSRM road distances, Open-Meteo weather. Set MAPS=off to hide them.
MAPS=on
# For heavy traffic run your own OSRM (or a paid router) and put its address here:
GEO_ROUTER_URL=

# ---- Destination photos (v3.2) ----
# Collect real photos of the 12 Tamil Nadu destinations from Wikimedia Commons on start and weekly. on/off
PHOTOS=on

# ---- Account security ----
# Reject passwords found in public data breaches (Have I Been Pwned; only 5 characters of a hash are sent). on/off
PWNED_CHECK=on
# 64 hex characters used to encrypt authenticator secrets. Leave blank to auto-create data/.secret-key
# (back that file up with the data folder; losing it means users must set up two-step verification again).
SECRET_KEY=

# Where accounts, bookings and photos are stored (keep on persistent disk, back it up)
DATA_DIR=./data

# Set to 1 when served over HTTPS (required in production; also needed for the microphone)
COOKIE_SECURE=0
# Set to 1 behind a reverse proxy (Nginx, Render, Railway) so rate limits see real client IPs
TRUST_PROXY=0
